    SELECT * FROM zta_ess_pf_main INTO TABLE gt_pf_ess_main
     WHERE pernr = im_emp_no
       AND zstatus_id   = '99'.

    IF sy-subrc = 0.

      LOOP AT gt_pf_ess_main INTO gs_pf_ess_main.
        MOVE-CORRESPONDING gs_pf_ess_main TO gs_pf_ess_s.
        APPEND gs_pf_ess_s  TO et_pf_loan.
      ENDLOOP..

      ex_flag = 'S'.
      ex_errormessage = 'Approved PF Loan Request'.

    ELSE.
      ex_flag = 'E'.
      ex_errormessage = 'No Approved PF Loan request'.
    ENDIF.

  ELSEIF im_int_app_flag = 'A'.

    CLEAR et_pf_loan[].

    CASE im_w_r.
      WHEN 'A' OR 'J'.
        SELECT DISTINCT
           a~pernr,
           a~zappln_no,
           a~zloan_type,
           a~zloan_type_desc,
           a~zcreated_date,
           a~zcreated_time,
           a~zcreated_by,
           a~zpayment_date,
           a~zloan_amt,
           a~zstatus_id,
           a~zstatus,
           b~zremarks,
           b~zchanged_by,
           a~zloan_amt
          FROM zta_ess_pf_main AS a
          INNER JOIN zta_ess_pf_txn AS b
          ON b~zappln_no = a~zappln_no
          INTO CORRESPONDING FIELDS OF TABLE @gt_pf_ess_s
          WHERE b~zstatus_id = @im_wfst
          AND   b~zchanged_by = @im_emp_no.

        "Approved ET_PF_LOAN

      WHEN 'R'.
        SELECT * FROM zta_ess_pf_main INTO CORRESPONDING FIELDS OF TABLE gt_pf_ess_s
          WHERE zstatus_id = im_wfst.

    ENDCASE.

    SELECT persa name1 FROM t500p INTO TABLE gt_persa.
    SELECT pernr sname persg persk werks FROM pa0001 INTO TABLE gt_name WHERE endda EQ '99991231'.

    LOOP AT gt_pf_ess_s INTO gs_pf_ess_s.
      READ TABLE gt_name INTO gs_name WITH KEY pernr = gs_pf_ess_s-pernr.
      gs_pf_ess_s-emp_name = gs_name-name.
*      READ TABLE gt_hrp INTO gs_hrp WITH KEY obj = gs_vis_aid-orgid.
*      gs_pf_ess_s- org_text = gs_hrp-stxt.
      READ TABLE gt_persa INTO gs_persa WITH KEY persa = gs_name-werks.
      gs_pf_ess_s-persa_text = gs_persa-name1.
      APPEND gs_pf_ess_s TO et_pf_loan.
      CLEAR gs_pf_ess_s.
    ENDLOOP.

*    SORT et_pf_loan BY zcreated_date DESCENDING
*                       zcreated_time DESCENDING.

  ENDIF.



ENDFUNCTION.


FORM loan_check USING    p_emp_no TYPE pernr_d
                         p_wd_reason TYPE zhr_essmss_pflon-zloan_type
                CHANGING p_flag   TYPE char1
                         p_message TYPE char100.


  SELECT SINGLE * FROM zta_ess_pf_ltype INTO gs_pf_loan_type WHERE zloan_type =  p_wd_reason.

* 1)Employee 12 months membership either previous or current company (Member has not completed 12 months of EPF membership.)

  CALL FUNCTION 'ZHR_HR_READ_INFOTYPE'
    EXPORTING
      ex_pernr = p_emp_no
      ex_infty = '0041'
      ex_begda = sy-datum
      ex_endda = sy-datum
    IMPORTING
      im_p0041 = lt_p0041.

  READ TABLE lt_p0041 INTO ls_p0041 WITH  KEY zdatety = 'Z2'.


  CALL FUNCTION 'FIMA_DAYS_AND_MONTHS_AND_YEARS'
    EXPORTING
      i_date_from = ls_p0041-zdate
      i_date_to   = sy-datum
    IMPORTING
      e_months    = lv_months.
  IF lv_months LT gs_pf_loan_type-zwd_elig_months .
    SELECT *
  FROM zta_pfmem_his_k
  INTO TABLE gt_pfmem_his_k
  WHERE pernr = p_emp_no.
    LOOP AT gt_pfmem_his_k INTO gs_pfmem_his_k.
      lv_months = lv_months + gs_pfmem_his_k-zno_of_months.
    ENDLOOP.
    IF lv_months LT gs_pf_loan_type-zwd_elig_months ..
      p_flag = 'E'.
      CONCATENATE 'Loan minimum eligible months - ' gs_pf_loan_type-zwd_elig_months 'Not serviced in PSU' INTO p_message SEPARATED BY space.
    ENDIF.
  ENDIF.


***********************************************************************************************
*check  2)Max Limit check (Maximum number of withdrawals permitted under this category has already been
*exhausted.)
*if Special Circum - (Only two withdrawals are permitted under Special Circumstances in a financial
*year)
************************************************************************************************

  CLEAR: lv_wd_count,lv_fy_start.

  " with the witdrawal reason match with the loan type


  IF p_flag NE 'E'.


    IF gs_pf_loan_type-zloan_type = 'SP'.
      lv_d = sy-datum.
      IF lv_d+4(2) LT 3.
        gv_check_mon = lv_d+0(4) - 1.
      ELSE.
        gv_check_mon = lv_d+0(4).
      ENDIF.
      CONCATENATE gv_check_mon '0401' INTO gv_check_mon.
      CONDENSE gv_check_mon NO-GAPS.
      lv_fy_start =  gv_check_mon.


      SELECT COUNT( * ) FROM zta_ess_pf_main
      INTO lv_wd_count WHERE pernr = p_emp_no
          AND zloan_type =  'SP'
           AND ( zstatus_id = '99' OR zstatus_id = '01' OR zstatus_id = '02' )
      AND zpayment_date >= lv_fy_start
     AND zpayment_date <= sy-datum.

      IF lv_wd_count >= gs_pf_loan_type-zmax_wd_limit.  "2.
        p_flag = 'E'.
        CONCATENATE 'Maximum' gs_pf_loan_type-zmax_wd_limit 'withdrwals permitted for special circumstances' INTO p_message SEPARATED BY space.
      ENDIF.

    ELSE.

      IF gs_pf_loan_type-zmax_wd_limit IS NOT INITIAL.

        SELECT COUNT( * ) FROM zta_ess_pf_main INTO lv_wd_count WHERE pernr = p_emp_no
                          AND zloan_type =  p_wd_reason
        AND ( zstatus_id = '99' OR zstatus_id = '01' OR zstatus_id = '02' ).

        IF lv_wd_count >= gs_pf_loan_type-zmax_wd_limit.
          p_flag = 'E'.
          p_message = 'Maximum  withdrwals permitted for these categories are exhausted'.
        ENDIF.


      ENDIF.

    ENDIF.


*--------------------------------------------------------------------*
* CHECK 3)Minimum withdrawal amount (Minimum withdrawal amount shall be ₹1,000.)
*--------------------------------------------------------------------*
    IF p_flag NE 'E'.
      IF gv_flag NE 'E'.
        IF gs_pf_ess_main-zloan_amt < gs_pf_loan_type-zmin_wd_amt.
          p_flag = 'E'.
          p_message = gs_pf_loan_type-zmin_wd_amt .
          CONCATENATE 'Minimum withdrawal amount shall be INR ' p_message INTO p_message SEPARATED BY space.
        ELSE.
          PERFORM balance_amount USING p_emp_no.
          gs_final-bal_tot = 0 - gs_final-bal_tot.
          lv_elig_amt = 75 * gs_final-bal_tot / 100 .
          IF gs_pf_main-zloan_amt GT lv_elig_amt.
            p_flag = 'E'.
            p_message = lv_elig_amt .
            CONCATENATE 'Manxmum withdrawal amount shall be INR ' p_message INTO p_message SEPARATED BY space.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

****************************************************************************************************************
*4)Requested amount > Eligible Member Balance (Requested amount exceeds the Eligible Member Balance)
****************************************************************************************************************
  IF p_flag NE 'E'..
    IF gv_flag NE 'E'.
      lv_elig_amt = lv_elig_amt * gs_pf_loan_type-zloan_percentage / 100.

      IF lv_req_amt IS INITIAL OR lv_req_amt <= 0.

        p_flag = 'E'.
        p_message = 'please enter the valid amount'.

      ELSEIF lv_elig_amt <= 0.

        p_flag = 'E'.
        p_message = 'eligible member balnce is insufficient'.
      ELSEIF lv_req_amt < lv_min_amt.

        p_flag = 'E'.
        p_message = 'Requested amount is below the minimum withdrawal amount'.

      ELSEIF lv_req_amt > lv_elig_amt.

        p_flag = 'E'.
        p_message = 'Requested amount exceeds the eligible member balance '.

      ENDIF.

      p_flag = 'S'.
      p_message = 'employee is eligilbe for pf withdrawals'.

    ENDIF.
  ENDIF.

ENDFORM.


FORM balance_amount USING p_emp_no TYPE pernr_d.

