FUNCTION zta_essmss_pf_loan .
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(IM_INT_APP_FLAG) TYPE  BOOLE_D OPTIONAL
*"     VALUE(IM_W_R) TYPE  BOOLE_D OPTIONAL
*"     VALUE(IM_APP_ID) TYPE  ZHR_ESS_WF_MASTR-WFID OPTIONAL
*"     VALUE(IM_EMP_NO) TYPE  PERNR_D OPTIONAL
*"     VALUE(IM_WITHDRAWREASON) TYPE  ZHR_ESSMSS_PFLON-ZLOAN_TYPE
*"       OPTIONAL
*"     VALUE(IM_WFST) TYPE  ZTA_ESS_PF_MAIN-ZSTATUS_ID OPTIONAL
*"  EXPORTING
*"     VALUE(EX_FLAG) TYPE  CHAR1
*"     VALUE(EX_ERRORMESSAGE) TYPE  CHAR100
*"     VALUE(ET_PF_SUMMARY) TYPE  ZTA_T_PF_SUMMARY
*"  TABLES
*"      ET_PFLOAN_TYPE STRUCTURE  ZTA_ESS_PF_LTYPE OPTIONAL
*"      ET_PF_LOAN TYPE  ZTA_ESS_PF_T OPTIONAL
*"      ET_PFMEM_HIS TYPE  ZTA_T_PFMEM_HIS OPTIONAL
*"----------------------------------------------------------------------
  " display the loans available - 19.10.2026
  " user applies for the loan - 20.10.2026

  IF im_int_app_flag = 'I'
     AND im_w_r = 'D'.

    SELECT *
      FROM zta_ess_pf_ltype
      INTO TABLE  gt_pfloan_type.

    IF sy-subrc = 0.
      ex_flag = 'S'.
      ex_errormessage = 'Loan type is found'.

      et_pfloan_type[] = gt_pfloan_type[].

    ELSE.
      ex_flag = 'E'.
      ex_errormessage = 'Loan type is not available'.
    ENDIF.

  ELSEIF im_int_app_flag = 'I' AND im_w_r = 'P'.
    SELECT *
    FROM zta_pfmem_his_k
    INTO TABLE gt_pfmem_his_k "et_pfmem_his
    WHERE pernr = im_emp_no.
    IF sy-subrc = 0.
      ex_flag = 'S'.
      ex_errormessage = 'Previous membership is found'.
      LOOP AT gt_pfmem_his_k INTO gs_pfmem_his_k.
        MOVE-CORRESPONDING gs_pfmem_his_k TO gs_pfmem_his.
        APPEND gs_pfmem_his TO et_pfmem_his.
      ENDLOOP.
    ELSE.

      ex_flag = 'E'.
      ex_errormessage = 'Previous membership not found'.
    ENDIF.
*    PERFORM previous_membership.
  ELSEIF im_int_app_flag = 'I' AND im_w_r = 'E'.
    gv_flag = 'E'.
    PERFORM loan_check USING im_emp_no im_withdrawreason
                       CHANGING ex_flag
                                ex_errormessage.
    IF ex_flag NE 'E'.
      ex_flag = 'S'.
    ENDIF.

  ELSEIF  im_int_app_flag = 'O' AND im_w_r = 'W'.

    CLEAR: gs_pf_ess_main,
           gs_pf_ess_txn,
           gv_unique_id.
    LOOP AT et_pf_loan INTO gs_pf_ess_s.
      MOVE-CORRESPONDING gs_pf_ess_s TO gs_pf_ess_main.
    ENDLOOP.
    lv_req_amt = gs_pf_ess_main-zloan_amt.
*    gv_flag = 'E'.  " to be removed once check condition completed
    PERFORM loan_check USING im_emp_no gs_pf_ess_main-zloan_type
                       CHANGING ex_flag
                                ex_errormessage.
    IF ex_flag NE 'E'.
*    PERFORM balance_amount USING im_emp_no.
*    IF sy-subrc <> 0.  " if no error

      SELECT SINGLE * FROM  zta_ess_pf_ltype INTO gs_pfloan_type  WHERE zloan_type = gs_pf_ess_s-zloan_type.
      IF sy-subrc IS INITIAL.
        gs_pf_ess_main-zloan_type_desc = gs_pfloan_type-zloan_type_desc.
      ENDIF.
      IF gs_pf_ess_main-zappln_no IS INITIAL OR gs_pf_ess_main-zappln_no EQ '0000000000'.
        " generate the new application

        CALL FUNCTION 'NUMBER_GET_NEXT'
          EXPORTING
            nr_range_nr = '01'
            object      = 'ZHR_ESS_PF'
          IMPORTING
            number      = gv_unique_id.
        gs_pf_ess_main-zcreated_by  = gs_pf_ess_main-zchanged_by.
        gs_pf_ess_main-zappln_no = gv_unique_id.
        gs_pf_ess_main-zcreated_date  = sy-datum.
        gs_pf_ess_main-zcreated_time  = sy-uzeit.
        gs_pf_ess_txn-zchanged_by    = gs_pf_ess_main-zcreated_by.
      ELSE.
        gv_unique_id = gs_pf_ess_main-zappln_no.
        gs_pf_ess_txn-zstatus_id = gs_pf_ess_main-zstatus_id.
        gs_pf_ess_txn-zchanged_by    = gs_pf_ess_main-zchanged_by.
        gs_pf_ess_txn-zremarks = gs_pf_ess_main-zremarks.
        gs_main1-zstatus       = gs_pf_ess_main-zstatus.
        CLEAR gs_pf_ess_main.
        SELECT SINGLE * FROM zta_ess_pf_main INTO gs_pf_ess_main WHERE zappln_no = gv_unique_id.
        gs_pf_ess_main-zstatus_id = gs_pf_ess_txn-zstatus_id.
        gs_pf_ess_main-zchanged_by  = gs_pf_ess_txn-zchanged_by.
        gs_pf_ess_main-zremarks      = gs_pf_ess_txn-zremarks.
        gs_pf_ess_main-zstatus      = gs_main1-zstatus .
      ENDIF.
      IF gs_pf_ess_main-zstatus_id = '99'.
        "Ajay Please write the code here and send message flag 'S' or 'E' and  success message or error message
        gs_pf_ess_main-zpayment_date = sy-datum.  " to be confirmed the date as user input or approved date
      ENDIF.
      APPEND gs_pf_ess_main  TO gt_main .
      MODIFY zta_ess_pf_main FROM TABLE gt_main.  " to be correctedgs_pf_ess_main
      COMMIT WORK.

      gs_pf_ess_txn-zappln_no = gs_pf_ess_main-zappln_no.
      gs_pf_ess_txn-zstatus_id = gs_pf_ess_main-zstatus_id.
      gs_pf_ess_txn-zchanged_date  = sy-datum.
      gs_pf_ess_txn-zchanged_time  = sy-uzeit.
      gs_pf_ess_txn-zremarks = gs_pf_ess_main-zremarks.

      MODIFY zta_ess_pf_txn FROM gs_pf_ess_txn.
      COMMIT WORK.
      IF sy-subrc IS INITIAL.
        ex_flag = 'S'.
        CASE gs_pf_ess_main-zstatus_id.

          WHEN '01'.
            ex_errormessage = 'PF Loan Submitted Successfully '.
          WHEN '02'.
            ex_errormessage =  'Level 1 Approver Approved Pending with Final Approver. ' .
          WHEN '99'.
            ex_errormessage =  'PF Loan approved.' .
        ENDCASE.
      ENDIF.

*    ENDIF.
    ENDIF.

  ELSEIF  im_int_app_flag = 'I'  AND im_w_r = 'R'.

    CLEAR et_pf_loan[].

    SELECT * FROM zta_ess_pf_main INTO TABLE gt_pf_ess_main
     WHERE zcreated_by = im_emp_no
       AND zloan_type  = im_withdrawreason
       AND ( zstatus_id   = '01'
